# ============================================================
#  LUUM API — Variables d'environnement
# ============================================================

# Base de données
DATABASE_URL="postgresql://user:password@localhost:5432/luum_db"

# App
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3001"

# Auth (better-auth)
BETTER_AUTH_SECRET="change-this-to-a-random-secret-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# Cloudflare R2 (photos + vocaux)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="luum-storage"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Wave (paiements Sénégal)
WAVE_API_KEY="wave_sk_..."
WAVE_WEBHOOK_SECRET="..."

# Email (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="Luum <no-reply@luum.app>"

# Expo Push Notifications
EXPO_ACCESS_TOKEN="your-expo-access-token"

# Taux de change (mis à jour quotidiennement via pg-boss)
EUR_TO_XOF_RATE=655.957
